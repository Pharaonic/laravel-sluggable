{
    "name": "pharaonic/laravel-sluggable",
    "description": "Simple, multi-column slugs for Laravel Eloquent models, powered by Pharaonic PHP Slugify.",
    "keywords": [
        "php",
        "laravel",
        "slug",
        "sluggable",
        "slugify",
        "eloquent",
        "model"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Pharaonic/laravel-sluggable/issues",
        "source": "https://github.com/Pharaonic/laravel-sluggable"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0",
        "pharaonic/php-slugify": "~8.2.1 || ~8.3.1 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Sluggable\\": "src/",
            "Pharaonic\\Sluggable\\Attributes\\": "src/Attributes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Sluggable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Sluggable\\SluggableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "style": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
