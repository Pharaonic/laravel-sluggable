{
    "name": "pharaonic/laravel-sluggable",
    "description": "Simple, multi-column slugs for Laravel Eloquent models, powered by Pharaonic PHP Slugify.",
    "keywords": [
        "php",
        "laravel",
        "slug",
        "sluggable",
        "slugify",
        "eloquent",
        "model"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Pharaonic/laravel-sluggable/issues",
        "source": "https://github.com/Pharaonic/laravel-sluggable"
    },
    "require": {
        "php": ">=8.0 <8.2",
        "illuminate/contracts": "^8.75",
        "illuminate/database": "^8.75",
        "illuminate/support": "^8.75",
        "illuminate/view": "^8.75",
        "pharaonic/php-slugify": "~8.0.4 || ~8.1.2"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^6.25",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Sluggable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Sluggable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Sluggable\\SluggableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "pint --test",
        "format": "pint",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
